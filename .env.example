# =============================================================================
# VEMAPI SITE (CoreAr) — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo como .env.local e preencha os valores reais.
# NUNCA commitar .env.local com valores reais!
#
# Para Vercel: adicione estas variáveis em:
#   https://vercel.com/SEU-PROJETO/settings/environment
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://vemapi.com.br        # URL pública do frontend
NEXT_PUBLIC_API_URL=http://localhost:5001          # URL da API backend (.NET)

# ─── Supabase (AC ANGRY Security) ───────────────────────────────────────────
# Criar projeto em: https://supabase.com/dashboard
# Executar SUPABASE_SCHEMA.sql no SQL Editor antes de usar.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...              # Anon key (pública, segura no client)

# ⚠️ NUNCA expor SUPABASE_SERVICE_ROLE_KEY no client-side!
# Encontra em: Settings → API → service_role (só server-side)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                  # Service role key (secreta!)

# ─── PKI / Segurança ────────────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Ou: openssl rand -hex 64
PKI_NONCE_SECRET=abc123...                        # 64 bytes hex (128 chars)
AUTH_JWT_SECRET=def456...                         # 64 bytes hex (128 chars)
PKI_ENCRYPTION_KEY=ghi789...                      # 64 bytes hex (128 chars) para AES-256-GCM

# ─── PSC Providers (Certificados em Nuvem) ──────────────────────────────────
# Vidaas (Soluti)
VIDAAS_CLIENT_ID=ANGRY_VIDAAS
VIDAAS_CLIENT_SECRET=
VIDAAS_API_URL=https://api.vidaas.com.br

# Syngular
SYNGULAR_CLIENT_ID=ANGRY_SYNGULAR
SYNGULAR_CLIENT_SECRET=
SYNGULAR_API_URL=https://api.syngular.com.br

# BirdID (Certisign)
BIRDID_CLIENT_ID=ANGRY_BIRD_ID
BIRDID_CLIENT_SECRET=
BIRDID_API_URL=https://api.birdid.com.br

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_MAX_LOGIN=5
RATE_LIMIT_MAX_EMIT=20
RATE_LIMIT_WINDOW=60

# ─── Auditoria ──────────────────────────────────────────────────────────────
AUDIT_RETENTION_DAYS=1825

# ─── Daily.co (Videoconferência) ────────────────────────────────────────────
# Opcional: para videoconferência com titular durante emissão
DAILY_API_KEY=seu_daily_api_key
DAILY_API_SECRET=seu_daily_api_secret

# ─── Asaas (Pagamentos / Billing) ───────────────────────────────────────────
# Opcional: para módulo de cobrança
ASAAS_API_KEY=seu_asaas_api_key
ASAAS_ENV=sandbox                                 # sandbox | production

# ─── 1Password Connect (Secrets Management) ─────────────────────────────────
# Opcional: para gerenciamento centralizado de segredos
OP_CONNECT_TOKEN=seu_op_connect_token
OP_CONNECT_HOST=http://localhost:8080
VAULT_ID=seu_vault_id

# ─── Scanner Biométrico (Extensão Chrome) ───────────────────────────────────
# Tipo de scanner usado pelo Native Host
# Valores: MOCK, FUTRONIC, SECUGEN, SUPREMA
AR_SCANNER_TYPE=MOCK

# ─── APM / Monitoramento ────────────────────────────────────────────────────
# Opcional: Sentry ou similar para rastreamento de erros em produção
NEXT_PUBLIC_SENTRY_DSN=

{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "INTEGRACAO.md",
    "SUPABASE_SCHEMA.sql"
  ],

  "plugin": [
    "token-efficiency@git+https://github.com/undefdev/token-efficiency.git"
  ],

  "references": {
    "angry-ac": {
      "path": "~/repos/angry-ac",
      "description": "AC ANGRY - certificacao digital ICP-Brasil"
    },
    "gs-vemapi": {
      "path": "~/repos/gs.vemapi",
      "description": "CoreAr backend .NET separado"
    }
  },

  "lsp": {
    "typescript": {
      "command": ["npx", "-y", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    },
    "tailwindcss": {
      "command": ["npx", "-y", "@tailwindcss/language-server", "--stdio"],
      "extensions": [".css", ".tsx", ".jsx"]
    }
  },

  "mcp": {
    "ruflo": {
      "type": "local",
      "command": ["npx", "-y", "ruflo@latest", "mcp", "start"],
      "enabled": true,
      "timeout": 30000
    }
  },

  "agent": {
    "build": {
      "model": "anthropic/claude-sonnet-4-6",
      "prompt": "Você está trabalhando no projeto VEMAPI SITE (CoreAr). É uma solução de gestão empresarial com: frontend Next.js 14 (TypeScript, Tailwind), backend .NET (C#), banco PostgreSQL, Redis e RabbitMQ. Prefira código limpo, componentização e segurança. Siga as convenções do projeto existente."
    }
  }
}

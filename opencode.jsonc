{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "INTEGRACAO.md",
    "SUPABASE_SCHEMA.sql",
    "specs/README.md"
  ],

  "plugin": [
    "token-efficiency@git+https://github.com/undefdev/token-efficiency.git"
  ],

  "references": {
    "vemapi": {
      "path": "~/OneDrive/Área de Trabalho/VEMAPI SITE",
      "description": "Projeto VEMAPI - plataforma de certificacao digital ICP-Brasil (Next.js + .NET)"
    },
    "angry-ac": {
      "path": "~/repos/angry-ac",
      "description": "AC ANGRY - certificacao digital ICP-Brasil"
    },
    "gs-vemapi": {
      "path": "~/repos/gs.vemapi",
      "description": "CoreAr backend .NET (identidade, ledger, CRM, billing)"
    },
    "spec-kit": {
      "path": "~/repos/spec-kit",
      "description": "Spec Kit - Spec-Driven Development toolkit (specify CLI)"
    }
  },

  "lsp": {
    "typescript": {
      "command": ["npx", "-y", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    },
    "tailwindcss": {
      "command": ["npx", "-y", "@tailwindcss/language-server", "--stdio"],
      "extensions": [".css", ".tsx", ".jsx"]
    }
  },

  "mcp": {
    "ruflo": {
      "type": "local",
      "command": ["npx", "-y", "ruflo@latest", "mcp", "start"],
      "enabled": true,
      "timeout": 30000
    },
    "open-design": {
      "type": "local",
      "command": ["npx", "-y", "od", "mcp", "start"],
      "enabled": false,
      "description": "Open Design MCP - 139 skills de design + ferramentas de projetos/artefatos"
    }
  },

  "agent": {
    "build": {
      "model": "anthropic/claude-sonnet-4-6",
      "prompt": "Você está trabalhando no projeto VEMAPI SITE (CoreAr). É uma solução de gestão empresarial com: frontend Next.js 16 (TypeScript, Tailwind), backend .NET 8 (C#), banco PostgreSQL, Redis e RabbitMQ. O projeto inclui: AC ANGRY (certificação digital ICP-Brasil), Landing Page, Portais (Admin/User), APIs Serverless, e CORE-AR (ERP para ARs). Siga as convenções do projeto existente e a constituição em .specify/memory/constitution.md."
    }
  }
}

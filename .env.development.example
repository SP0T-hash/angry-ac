# Desenvolvimento — o Next carrega .env.development automaticamente com `npm run dev`.
# Não use segredos reais. Mantenha modo sandbox.

NEXT_PUBLIC_APP_ENVIRONMENT=development
NEXT_PUBLIC_ENVIRONMENT_LABEL=Ambiente de desenvolvimento
NEXT_PUBLIC_SHOW_ENV_BANNER=true
NEXT_PUBLIC_BRAND_NAME=VEMAPI

# Supabase (sandbox/local)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-de-exemplo
SUPABASE_SERVICE_ROLE_KEY=service-role-de-exemplo

# Segurança (gerar com: openssl rand -hex 64)
AUTH_JWT_SECRET=dev-insecure-change-me
PKI_NONCE_SECRET=dev-insecure-change-me

# Emissão ICP-Brasil — SEMPRE bloqueada em dev
AC_INTEGRATION_ENABLED=false
AC_API_URL=

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ArBiometricHost</AssemblyName>
    <RootNamespace>ArBiometricHost</RootNamespace>

    <!--
      Publicação para Chrome Native Messaging:
        dotnet publish -c Release
        O binário estará em: bin/Release/net8.0/win-x64/publish/ArBiometricHost.exe
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>

    <!--
      Script de instalação (pós-build):
        powershell -ExecutionPolicy Bypass -File install.ps1
      Copia o binário e o manifest para os diretórios corretos.
    -->
    <PostBuildEvent Condition="'$(Configuration)'=='Release'">
      powershell -ExecutionPolicy Bypass -File "$(ProjectDir)install.ps1" -BinPath "$(TargetDir)publish"
    </PostBuildEvent>
  </PropertyGroup>

  <!--
    ===========================================================================
    DEPENDÊNCIAS DOS SDKs BIOMÉTRICOS
    ===========================================================================

    Descomente o pacote correspondente ao hardware instalado na máquina.

    Futronic FS80/FS90:
      <PackageReference Include="Futronic.SDK.FS80" Version="1.0.0" />

    SecuGen FDx Pro / Hamster:
      <PackageReference Include="SecuGen.FDxSDK" Version="1.0.0" />

    Suprema BioMini / RealScan:
      <PackageReference Include="Suprema.BiometricSDK" Version="2.0.0" />
    -->

  <!-- Logging estruturado -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

</Project>

# Produção — o Next carrega .env.production automaticamente com `npm run build`/`start`.
# Use segredos REAIS em ambiente seguro. NUNCA commitar este arquivo.

NEXT_PUBLIC_APP_ENVIRONMENT=production
NEXT_PUBLIC_ENVIRONMENT_LABEL=Ambiente de produção
NEXT_PUBLIC_SHOW_ENV_BANNER=false
NEXT_PUBLIC_BRAND_NAME=VEMAPI

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-producao
SUPABASE_SERVICE_ROLE_KEY=service-role-producao

AUTH_JWT_SECRET=gere-com-openssl-rand-hex-64
PKI_NONCE_SECRET=gere-com-openssl-rand-hex-64

# Emissão continua bloqueada até AC/DPC/homologação.
AC_INTEGRATION_ENABLED=false
AC_API_URL=
